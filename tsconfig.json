{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "types": [
      "vitest/globals",
      "@daintreehq/plugin-sdk/plugin-ui",
      "@daintreehq/plugin-sdk/view-globals"
    ]
  },
  "include": [
    "src",
    "vite.config.ts",
    "vite.config.worker.ts",
    "vitest.config.ts"
  ]
}
